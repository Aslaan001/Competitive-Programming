/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */

void fun(map<TreeNode*,int>&m1,TreeNode* root){
    if(root==NULL) return ;
    m1[root]=root->val;
    fun(m1,root->left);
    fun(m1,root->right);
}


void solve(TreeNode* &root,int k){
    if(root==NULL) return ;
    root->val=k;
    solve(root->right,k+1);
    solve(root->left,k-1);
}




bool comp(vector<int>&a ,vector<int>&b){
    if(a[0]!=b[0]) return a[0]<b[0];
    if(a[1]!=b[1]) return a[1]<b[1];
    return a[2]<b[2];
}

class Solution {
public:
    vector<vector<int>> verticalTraversal(TreeNode* root) {
        map<TreeNode*,int>m1;


        vector<vector<int>>ans;

        map<int,vector<int>>m2;

        TreeNode* temp=root;


        fun(m1,root);
        solve(temp,0);


        queue<TreeNode*>q1;
        
        if(root!=NULL)
        q1.push(root);


        int l=0;


        while(!q1.empty()){
            int n=q1.size();
            vector<int>v1;

            for(int i=0;i<n;i++){
            TreeNode* node=q1.front();
            int kk=node->val;
            q1.pop();
           // v1.push_back(kk);
            //m2[kk].push_back(m1[node]);

            ans.push_back({kk,l,m1[node]});


            if(node->left!=NULL){
                q1.push(node->left);
            }

            if(node->right!=NULL){
                q1.push(node->right);
            }
            }

           l++;
        }


        sort(ans.begin(),ans.end(),comp);


        for(auto a:ans){
            m2[a[0]].push_back(a[2]);
        }


        ans.clear();



        for(auto a:m2){
            ans.push_back(a.second);
        } 


        return ans;
    }






