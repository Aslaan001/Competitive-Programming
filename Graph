void bfs(vector<int>&ans,vector<int>adj[],vector<int>vis,int start){
     //cout<<"Yes";
     vis[start]=1;
     queue<int>q;
     q.push(start);

     while(q.size()>0){
        int node=q.front();
        q.pop();
        ans.push_back(node);
        

        for(auto a:adj[node]){
           if(vis[a]==0){
             q.push(a);
             vis[a]=1;
           }
        }
     }
     
     return ;
}


void dfs(vector<int>&ans,vector<int>adj[],vector<int>&vis,int start){
    
    if(vis[start]==1) return ;

    vis[start]=1;
    ans.push_back(start);

    for(auto a:adj[start]){
        if(vis[a]==0){
            dfs(ans,adj,vis,a);
        }
    }

    return ;
}



// i,j are starting points 

void bfs_matrix(int i,int j,vector<vector<int>>&vis,vector<vector<int>>&grid){
     vis[i][j]=1;
     queue<pair<int,int>>q;
     q.push({i,j});

     int n=grid.size();
     int m=grid[0].size();


     while(q.size()>0){

      
      int r=q.front().first;
      int c=q.front().second;

      q.pop();

      // now positon from there we reach are 

      int nr,nc;

      nr=r,nc=c+1;

      if(nc<m && grid[nr][nc]==1 && vis[nr][nc]==0){
            vis[nr][nc]=1;
            q.push({nr,nc});
      }

      nr=r+1,nc=c;
      
      if(nr<n && grid[nr][nc]==1 && vis[nr][nc]==0){
            vis[nr][nc]=1;
            q.push({nr,nc});
      }


      nr=r-1,nc=c;
      
      if(nr>=0 && grid[nr][nc]==1 && vis[nr][nc]==0){
            vis[nr][nc]=1;
            q.push({nr,nc});
      }

      nr=r,nc=c-1;
      
      if(nc>=0 && grid[nr][nc]==1 && vis[nr][nc]==0){
            vis[nr][nc]=1;
            q.push({nr,nc});
      }






     }
} 



bool bfs_undirected_cycle(int s,vector<int>adj[],vector<int>&vis){
      vis[s]=1;
      queue<pair<int,int>>q;
      q.push({s,-1});

      while(!q.empty()){
            int node=q.front().first;
            int parent=q.front().second;
            q.pop();


            for(auto a:adj[node]){
                  if(vis[a]==0){
                        vis[a]=1;
                        q.push({a,node});
                  }
                  else if(a!=parent){
                        return 1;
                  }
            }

      }

      return 0;
}


bool dfs_undirected_cycle(int s,int p,vector<int>adj[],vector<int>&vis){
      vis[s]=1;

      for(auto a:adj[s]){
            if(vis[a]==0){
                  if(dfs_undirected_cycle(a,s,adj,vis)==1) return 1;
            }
            else if(a!=p) return 1;
      }

      return 0;
}



bool bfs_bipirate(vector<int>&color,vector<int>adj[],int s){
      queue<int>q;
      color[s]=0;
      q.push(s);

      while(!q.empty()){
            int node=q.front();
            q.pop();


            for(auto a:adj[node]){
                  if(color[a]==-1){
                        color[a] = ! color[node];  // opposite color of parent
                        q.push(a); 
                  }
                  else if(color[a]==color[node]){
                        return false;
                  }
            }
      }

      return 1;
}


// checks Graph coloring with two alternate color possible or not 
bool dfs_bipirate(vector<int>&color,int s=0,int p_c,vector<int>adj[]){
      
      color[s]=p_c;

      for(auto a:adj[s]){
            if(color[a]==-1){
                if(dfs_bipirate(color,a, ! color[s],adj) ==0 ) return 0;
            }
            else if(color[a]==color[s]) return 0;
      }

      return 1;
}


bool dfs_directed_cycle(int s,vector<int>adj[],vector<int>vis,vector<int>cur_path){
      vis[s]=1;
      cur_path[s]=1;


      for(auto a:adj[s]){
            if(vis[a]==0){
                  if(dfs_directed_cycle(a,adj,vis,cur_path)==1) return 1;
            }
            else if(vis[a]==1 && cur_path[a]==1) return 1;
      }




      cur_path[s]=0;
      return 0;
}



