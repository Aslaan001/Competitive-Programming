}



vector<int> topological_sort_bfs(vector<int>adj[],vector<int>&indeg,int s,int n){

      vector<int>ans;
      queue<int>q;
      
      for(int i=0;i<n;i++){
            if(indeg[i]==0){
            q.push(i);
            }
      }

      while(!q.empty()){
            int node=q.front();
            q.pop();
            ans.push_back(node);

            for(auto a:adj[node]){    // at all points to which this node is going decrease its contribution of in degree 
               indeg[a]--;
               if(indeg[a]==0) q.push(a);
            }
      }

      return ans;
}







